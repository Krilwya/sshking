POSTGRES_PASSWORD=replace-with-a-long-random-value
SSHKING_PUBLIC_URL=https://cloud.example.com

# Google OAuth Web application. Redirect URI:
# https://cloud.example.com/v1/auth/callback/google
SSHKING_GOOGLE_CLIENT_ID=
SSHKING_GOOGLE_CLIENT_SECRET=

# Apple Service ID and generated client-secret JWT. Return URL:
# https://cloud.example.com/v1/auth/callback/apple
SSHKING_APPLE_CLIENT_ID=
SSHKING_APPLE_CLIENT_SECRET=
